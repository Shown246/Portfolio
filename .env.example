# Google AI Studio API key for the portfolio chatbot.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Resend API Key for sending emails from the contact form.
# Get a free key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=re_123456789

# Your personal email address where you want to receive contact form messages
CONTACT_EMAIL=your-email@example.com
